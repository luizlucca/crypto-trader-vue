{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "shared/*"
      ],
      "@/*": [
        "src/*"
      ],
      "@app/*": [
        "src/app/*"
      ],
      "@chart/*": [
        "src/features/chart/*"
      ],
      "@desktop/*": [
        "src/platform/desktop/*"
      ],
      "@drawings/*": [
        "src/features/drawings/*"
      ],
      "@indicators/*": [
        "src/features/indicators/*"
      ],
      "@market/*": [
        "src/features/market/*"
      ],
      "@orderbook/*": [
        "src/features/orderbook/*"
      ],
      "@positions/*": [
        "src/features/positions/*"
      ],
      "@renderer-shared/*": [
        "src/shared/*"
      ],
      "@settings/*": [
        "src/features/settings/*"
      ],
      "@trading/*": [
        "src/features/trading/*"
      ],
      "@workspace/*": [
        "src/features/workspace/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "shared/**/*.ts",
    "vitest.config.ts"
  ]
}
